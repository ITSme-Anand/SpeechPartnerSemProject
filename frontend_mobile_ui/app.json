{
  "expo": {
    "name": "SpeechPartner",
    "slug": "speechpartner-mobile",
    "scheme": "speechpartner",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.speechpartner.mobile",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "SpeechPartner needs microphone access to record your practice sessions so it can transcribe and give you feedback."
      }
    },
    "android": {
      "package": "com.speechpartner.mobile",
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "SpeechPartner needs microphone access to record your practice sessions."
        }
      ],
      "expo-asset"
    ]
  }
}
