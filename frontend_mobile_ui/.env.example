# Copy this file to .env and fill in real values before connecting to a live backend.
# Expo only inlines variables prefixed with EXPO_PUBLIC_ into the client bundle —
# never put a secret (service-role key, private API key, etc.) behind that prefix,
# because it ships inside the app binary and is readable by anyone who installs it.
# The Supabase "anon" key below is designed to be public; row-level security on
# the Supabase project is what actually protects data, not keeping this key secret.

# When true, the app runs entirely on local fixture data (src/services/fixtures)
# and never calls the network. Use this to demo/test the UI before the FastAPI
# backend described in the tech-stack doc is deployed.
EXPO_PUBLIC_USE_MOCK_DATA=true

# Base URL of the FastAPI backend. Must be HTTPS in any non-local environment.
EXPO_PUBLIC_API_BASE_URL=https://localhost:8000

# Supabase project (safe/public anon key, not the service-role key).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
