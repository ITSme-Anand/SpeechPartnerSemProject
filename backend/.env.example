# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Groq (used for Whisper STT + Drill Generator LLM)
GROQ_API_KEY=your-groq-api-key

# Google Gemini (used for Speech Analyser)
GEMINI_API_KEY=your-gemini-api-key

# Model configuration (defaults shown, override if needed)
# GROQ_STT_MODEL=whisper-large-v3
# GROQ_CHAT_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.5-pro

# Frontend URL for CORS (set to your Vercel frontend, Amplify, or custom domain)
# Examples:
# FRONTEND_URL=https://speech-partner-sem-project.vercel.app
FRONTEND_URL=https://speech-partner-sem-project.vercel.app

# Optional extra CORS origins (comma-separated, or * to allow all origins)
# CORS_ORIGINS=http://localhost:5173,https://my-preview.vercel.app

# Port for backend container (defaults to 8000)
PORT=8000

# Optional Domain for Caddy automatic SSL (e.g., api.yourdomain.com or <ip-with-dashes>.sslip.io)
# DOMAIN=api.yourdomain.com


